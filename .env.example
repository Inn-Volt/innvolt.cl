# Copia este archivo como ".env.local" y completa los valores.
# Las variables NEXT_PUBLIC_* quedan visibles en el navegador (es normal para estas).

# Google Analytics 4 (opcional). Crea una propiedad en analytics.google.com.
# Si lo dejas vacío, el sitio funciona igual pero no mide visitas ni conversiones.
NEXT_PUBLIC_GA_ID=

# EmailJS — envío del formulario de contacto (https://www.emailjs.com).
# Si no las defines, el código usa las claves por defecto que ya están en ContactForm.tsx.
# Recomendado: restringir los dominios permitidos en el panel de EmailJS.
NEXT_PUBLIC_EMAILJS_SERVICE=
NEXT_PUBLIC_EMAILJS_TEMPLATE=
NEXT_PUBLIC_EMAILJS_KEY=

# Supabase (opcional, aún no se usa en el sitio).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
